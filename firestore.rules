rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owns(data) {
   return signedIn() && (data.get('ownerId', '') == request.auth.uid
    || data.get('ownerUid', '') == request.auth.uid
    || data.get('uid', '') == request.auth.uid
    || data.get('userId', '') == request.auth.uid
    || request.auth.uid in data.get('adminUids', []));
  }
  function manages(businessId) {
   return signedIn() && businessId is string &&
    owns(get(/databases/$(database)/documents/businesses/$(businessId)).data);
  }
  match /users/{uid} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['uid','firstName','lastName','email','activeBusinessId','businessIds','createdAt'])
    && request.resource.data.uid == uid;
   allow update: if signedIn() && request.auth.uid == uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName','lastName','email','activeBusinessId','businessIds']);
  }
  match /businesses/{businessId} {
   allow read: if owns(resource.data);
   allow create: if signedIn()
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.ownerUid == request.auth.uid
    && request.resource.data.businessId == businessId
    && request.resource.data.plan == 'start'
    && request.resource.data.status == 'active'
    && request.resource.data.keys().hasOnly(['businessId','ownerId','ownerUid','businessName','businessType','industry','country','phone','address','about','plan','status','profileComplete','setupProgress','stats','opportunities','createdAt','updatedAt']);
   allow update: if owns(resource.data)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['businessName','businessType','industry','country','phone','address','about','profileComplete','setupProgress','updatedAt']);
  }
  match /products/{productId} {
   allow read: if manages(resource.data.businessId);
   allow create: if manages(request.resource.data.businessId);
   allow update: if manages(resource.data.businessId)
    && request.resource.data.businessId == resource.data.businessId;
  }
  match /orders/{orderId} {
   allow read: if manages(resource.data.businessId);
   allow create: if manages(request.resource.data.businessId);
   allow update: if manages(resource.data.businessId)
    && request.resource.data.businessId == resource.data.businessId;
  }
  // Legacy catalog channel metadata only. OAuth credentials belong in server-only integrations.
  match /channels/{channelId} { allow read: if manages(resource.data.businessId); }
  // Banking details, tokens, balances and seller operations are accessed through authenticated Functions.
  match /{document=**} { allow read, write: if false; }
 }
}
